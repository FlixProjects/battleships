{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "ESNext",
        "target": "es6",
        "lib": ["ES2023", "DOM"],
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "types": ["jest"],
        "paths": {
            "@shared/*": ["./shared/*"]
        },
        "strictPropertyInitialization": false
    },
    "include": ["src", "shared"]
}
