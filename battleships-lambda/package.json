{
    "name": "battleships lambda",
    "version": "1.0.0",
    "description": "Serverless backend for Battleships",
    "main": "app.js",
    "repository": "https://github.com/awslabs/aws-sam-cli/tree/develop/samcli/local/init/templates/cookiecutter-aws-sam-hello-nodejs",
    "author": "SAM CLI",
    "license": "MIT",
    "scripts": {
        "start": "npm run db:up && npm run db:init && npm run start:api",
        "start:api": "sam build && sam local start-api --docker-network battleships-local",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:init": "node scripts/create-tables.mjs",
        "compile": "tsc",
        "build": "sh scripts/build.sh"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.908.0",
        "@aws-sdk/client-s3": "^3.908.0",
        "@aws-sdk/client-ssm": "^3.1116.0",
        "@aws-sdk/lib-dynamodb": "^3.908.0",
        "aws-lambda": "^1.0.7",
        "esbuild": "^0.14.14",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.92",
        "@types/node": "^20.19.43",
        "@types/uuid": "^10.0.0",
        "prettier": "^2.5.1",
        "ts-node": "^10.9.1",
        "typescript": "^4.8.4"
    }
}
