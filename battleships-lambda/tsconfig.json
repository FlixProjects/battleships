{
    "compilerOptions": {
        "target": "es2020",
        "strict": true,
        "preserveConstEnums": true,
        "outDir": "dist",
        "noEmit": true,
        "sourceMap": false,
        "module": "Node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "exclude": ["node_modules", "../node_modules"]
}
