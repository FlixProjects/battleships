{
    "compilerOptions": {
        "target": "es2020",
        "strict": true,
        "preserveConstEnums": true,
        "outDir": "dist",
        // the editor's language service applies the rootDir check even under
        // noEmit; without this, every `../shared` import is a red squiggle
        "rootDir": "..",
        "noEmit": true,
        "sourceMap": false,
        "module": "Node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "exclude": ["node_modules", "../node_modules"]
}
